
@{
    ViewBag.Title = "Error";
    Layout = "~/Views/Shared/_MasterLayout.cshtml";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow p-4 text-center">
                <h4 class="mb-3 text-danger">
                    <i class="fa-solid fa-triangle-exclamation"></i> Lỗi @ViewBag.StatusCode
                </h4>
                <p class="text-muted">@ViewBag.Message</p>

                <a href="@Url.Action("Home_page", "HomePage")" class="btn btn-outline-dark">
                    <i class="fa-solid fa-house"></i> Quay về trang chủ
                </a>
            </div>
        </div>
    </div>
</div>




